# =====================================================================
# SOC-Lite · Variables de entorno (plantilla)
# Copiar a `.env` en la raíz del proyecto y ajustar.
# NUNCA versionar el archivo `.env` real (ISO 27001 A.5.17 / A.8.24).
# =====================================================================

# ---------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------
APP_NAME=SOC-Lite
APP_VERSION=1.0.0
ENVIRONMENT=development            # development | staging | production
DEBUG=false
TIMEZONE=America/Santiago
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Seguridad (CAMBIAR OBLIGATORIAMENTE EN PRODUCCIÓN)
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------
SECRET_KEY=CAMBIAR-ESTA-CLAVE-POR-UNA-ALEATORIA-DE-48-BYTES-MINIMO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=480
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Tokens internos (n8n ↔ backend ↔ microservicio LLM)
INTERNAL_SERVICE_TOKEN=cambiar-token-servicio-interno
INGEST_API_KEY=cambiar-clave-ingesta-wazuh

# CORS (separar por comas)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=soclite
POSTGRES_PASSWORD=cambiar-password-postgres
POSTGRES_DB=soclite
POSTGRES_SCHEMA=soclite
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
ENRICHMENT_CACHE_TTL=86400

# ---------------------------------------------------------------------
# Microservicio LangChain y LLM
# ---------------------------------------------------------------------
LANGCHAIN_SERVICE_URL=http://langchain:8001
# URL interna del backend que usa el microservicio para consultar el contexto
# histórico de reglas y la memoria de falsos positivos (/api/v1/internal/*).
# En Docker: http://backend:8000 · En local: http://127.0.0.1:8000
BACKEND_URL=http://backend:8000
LANGCHAIN_TIMEOUT_SECONDS=120
LANGCHAIN_MAX_RETRIES=3
TRIAGE_PROMPT_VERSION=triage_v3

LLM_PROVIDER=ollama                # ollama | openai | azure
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1

# Sólo si la política de datos lo autoriza explícitamente.
# Con false, las alertas NUNCA salen de la infraestructura.
ALLOW_EXTERNAL_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MAX_AGENT_ITERATIONS=8
AGENT_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------
# Inteligencia de amenazas (opcionales; sin clave, la tool no se carga)
# ---------------------------------------------------------------------
THREAT_INTEL_ENABLED=true
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=
# Ruta al archivo GeoLite2-City.mmdb descargado de MaxMind (requiere registro gratuito)
GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# ---------------------------------------------------------------------
# Notificaciones y ticketing
# ---------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#soc-alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soc-lite@org.local

OSTICKET_BASE_URL=
OSTICKET_API_KEY=
REDMINE_BASE_URL=
REDMINE_API_KEY=

# ---------------------------------------------------------------------
# Reglas de negocio del triaje
# ---------------------------------------------------------------------
MIN_SEVERITY_TO_PROCESS=7          # nivel de regla Wazuh mínimo para triar
DEDUP_WINDOW_MINUTES=5
SUPPRESSION_WINDOW_MINUTES=30
RISK_SCORE_ESCALATION_THRESHOLD=75
AUTO_CLOSE_FP_CONFIDENCE=0.90

# ---------------------------------------------------------------------
# Reportes
# ---------------------------------------------------------------------
REPORTS_DIR=./storage/reports
REPORT_RETENTION_DAYS=365
COMPANY_NAME=Organización Demo S.A.
COMPANY_LOGO=./assets/logo.png

# ---------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | console
ENABLE_METRICS=true
SENTRY_DSN=

# Trazas de LangChain (opcional, envía trazas a LangSmith: evaluar confidencialidad)
ENABLE_LANGSMITH=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=soc-lite-triage

# ---------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=SOC-Lite

# ---------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar-password-n8n
GENERIC_TIMEZONE=America/Santiago
N8N_ENCRYPTION_KEY=cambiar-clave-cifrado-n8n
