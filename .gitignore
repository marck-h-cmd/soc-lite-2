# =====================================================================
# SOC-Lite · Reglas de exclusión de Git
# =====================================================================

# --- Secretos (NUNCA versionar) ---
.env
.env.*
!.env.example
*.pem
*.key
deploy/certs/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Node / frontend ---
node_modules/
.pnpm-store/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Datos locales y artefactos ---
storage/
data/
*.sqlite3
*.db
backend/storage/
logs/
*.log
# Estado local de la puesta en marcha (clúster PostgreSQL propio, cachés)
.pgdata/
.pip-cache/
.npm-cache/
.pnpm-home/
.chrome-profile*/
.shots/

# --- Modelos e IP locales ---
*.mmdb
data/geoip/

# --- Editores y SO ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Respaldos ---
*.dump
*.bak
*.tar.gz
*.zip
