# =============================================================================
# SOC-Lite · Frontend — Variables de entorno
# Copiar a `.env.local` y ajustar. Vite solo expone variables con prefijo VITE_.
# =============================================================================

# URL base de la API del backend (incluye el prefijo /api/v1 del contrato).
# Si se deja vacío, el cliente usa la ruta relativa `/api/v1` y el proxy de Vite
# (vite.config.ts) redirige a http://localhost:8000 — modo recomendado en desarrollo.
VITE_API_URL=http://localhost:8000/api/v1

# Timeout por defecto de las peticiones HTTP, en milisegundos.
VITE_API_TIMEOUT_MS=30000

# Habilita React Query Devtools en desarrollo (true|false).
VITE_ENABLE_DEVTOOLS=false

# Nombre mostrado en la barra superior y en el título del documento.
VITE_APP_NAME=SOC-Lite

# Antelación, en segundos, con la que se refresca el access token antes de expirar.
# El access token dura 30 min y el refresh token 8 h (docs/00-contrato-api.md §1).
VITE_REFRESH_SKEW_SECONDS=60
